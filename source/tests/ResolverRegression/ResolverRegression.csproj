<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>ResolverRegression</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <Compile Include="../../Patcher/*.cs" Link="Patcher/%(Filename)%(Extension)" />
    <None Include="../../build/HostPause.Runtime.dll" CopyToOutputDirectory="PreserveNewest" Link="HostPause.Runtime.dll" />
    <None Include="../../assets/banner.png" CopyToOutputDirectory="PreserveNewest" Link="HostPause.banner.png" />
  </ItemGroup>
</Project>
